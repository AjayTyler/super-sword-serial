<header class="sss-header img-name">
    <img src="{{source.img}}" data-action="editImage" data-edit="img" alt="{{document.name}}"
         data-tooltip="{{localize 'SSS.EditImage'}}">
    <input name="name" type="text" value="{{source.name}}"
           placeholder="{{localize 'SSS.Item.NamePlaceholder'}}"
           aria-label="{{localize 'SSS.Item.NamePlaceholder'}}">
</header>
